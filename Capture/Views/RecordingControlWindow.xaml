<!-- author: eng-fe-desktop -->
<!-- phase: engineering -->
<!-- new(frame-based): 프레임 기반 녹화 컨트롤 바. 시작/일시정지·재개/중단 버튼 + 경과시간 +
     접기/펼치기(접힘 시 상태 색 점). 녹화 상태는 테두리(region) 색으로 표시(상태 텍스트 제거).
     RecordingBorderWindow 와 달리 클릭 가능해야 하므로 IsHitTestVisible/WS_EX_TRANSPARENT 를 쓰지 않는다.
     녹화 영역 '바깥'에 인접 배치되어(코드비하인드 SetWindowPosPhysical) 녹화 영상에 안 찍힌다.
     Window 마우스 이벤트는 대기 상태 배경 드래그로 region 을 이동하는 핸들(코드비하인드). -->
<Window x:Class="Capture.Views.RecordingControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Border Background="#EE202020" CornerRadius="6" Padding="8,6" BorderBrush="#FF3C3C3C" BorderThickness="1">
        <Grid>

            <!-- 펼침(기본, 대기): 시작/재개·중단 버튼 + 경과시간 + 접기. 상태는 테두리 색으로 표시. -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ControlsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- 주 버튼: ▶ 시작/재개 · ⏸ 일시정지 — 상태에 따라 아이콘·동작 전환(PrimaryAction). -->
                <Button Content="{Binding PrimaryIcon}"
                        Command="{Binding PrimaryActionCommand}"
                        IsEnabled="{Binding CanPrimary}"
                        FontFamily="Segoe UI Symbol" FontSize="13"
                        Width="34" Height="26" Margin="0,0,4,0"/>

                <!-- 보조 버튼: ✕ 대기 취소 · ■ 중단 — 상태에 따라 아이콘·동작 전환(SecondaryAction). -->
                <Button Content="{Binding SecondaryIcon}"
                        Command="{Binding SecondaryActionCommand}"
                        IsEnabled="{Binding CanSecondary}"
                        FontFamily="Segoe UI Symbol" FontSize="13"
                        Width="34" Height="26" Margin="0,0,8,0"/>

                <TextBlock Text="{Binding ElapsedText}"
                           Foreground="#FFDDDDDD" FontFamily="Consolas"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- 접기(«): 녹화 영상 가림 최소화용. 클릭 시 펼치기 버튼 + 상태 색 점만 남긴다. -->
                <Button Content="«"
                        Command="{Binding ToggleControlsCollapsedCommand}"
                        FontSize="13" Width="26" Height="26"/>

            </StackPanel>

            <!-- 접힘: 펼치기(») + 상태 색 점. 색 점은 테두리와 같은 색(RecordingBorderBrush)이라
                 전체화면·접힘에서도 녹화 여부가 색으로 보인다. -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ControlsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}">

                <Button Content="»"
                        Command="{Binding ToggleControlsCollapsedCommand}"
                        FontSize="13" Width="26" Height="26" Margin="0,0,6,0"/>

                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                         Fill="{Binding RecordingBorderBrush}"/>

            </StackPanel>

        </Grid>
    </Border>
</Window>
