<!-- new: 녹화 중 영역 경계 표시 오버레이. 투명·Topmost·클릭통과. -->
<!-- 테두리(Border)는 창이 녹화 영역보다 두께만큼 바깥으로 확장 배치되므로(코드비하인드
     SetWindowPosPhysical) 영역 '바깥' 링에만 그려진다 → 녹화 영상(영역 내부)에 안 찍힘. -->
<Window x:Class="Capture.Views.RecordingBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False">

    <!-- BorderThickness 는 코드비하인드 BorderDip(3.0) 과 반드시 일치.
         BorderBrush 는 MainViewModel.RecordingBorderBrush(상태 색: 대기=흰/녹화=빨강/일시정지=주황/마감=회색) 바인딩. -->
    <Border BorderBrush="{Binding RecordingBorderBrush}" BorderThickness="3" Background="Transparent"/>
</Window>
